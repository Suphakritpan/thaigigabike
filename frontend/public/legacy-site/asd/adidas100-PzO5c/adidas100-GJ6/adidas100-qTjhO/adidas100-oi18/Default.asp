	<p>2014-11-2</p>
	<p>adidas &#12495;&#12491;&#12540;&#12501;&#12483;&#12463; &#12473;&#12491;&#12540;&#12459;&#12540;adidas &#12450;&#12487;&#12451;&#12480;&#12473; &#12501;&#12449;&#12452;&#12516;&#12540;&#12496;&#12540;&#12489;&#12472;&#12515;&#12540;&#12472;adidas &#12497;&#12540;&#12459;&#12540; &#12467;&#12540;&#12487;&#12451;&#12493;&#12540;&#12488; &#12513;&#12531;&#12474;adidas &#12473;&#12491;&#12540;&#12459;&#12540; &#24215;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12473;  &#12522;&#12524;&#12540;&#12473;&#12525;&#12540;  &#27005;&#22825;&#36196;adidas &#12458;&#12522;&#12472;&#12490;&#12523;&#12473; &#30333;&#37329;adidas &#12521;&#12501;&#12471;&#12514;&#12531;&#12474;&#12450;&#12487;&#12451;&#12480;&#12473; &#12459;&#12531;&#12488;&#12522;&#12540; 2014&#12450;&#12513;&#26449; &#12473;&#12479;&#12531;&#12473;&#12511;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473; &#12497;&#12540;&#12459;&#12540; &#32209;&#12288;&#20605;&#29289;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; adidas&#26178;&#35336; adidas &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12465;&#12531;&#12502;&#12522;&#12483;&#12472; CAMBRIDGE &#12513;&#12531;&#12474; &#12524;&#12487;&#12451;&#12540;&#12473; &#12518;&#12491;&#12475;&#12483;&#12463;&#12473;/&#30007;&#22899;&#20860;&#29992;/&#12502;&#12523;&#12540; ADH2099 [&#36870;&#36664;&#20837; &#28023;&#22806;&#12514;&#12487;&#12523; &#26032;&#21697;][&#12461;&#12483;&#12474; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#26178;&#35336; &#12473;&#12509;&#12540;&#12484; &#12469;&#12483;&#12459;&#12540;]&#12365;&#12419;&#12426;&#12540;&#12401;&#12415;&#12421;&#12401;&#12415;&#12421; &#12450;&#12487;&#12451;&#12480;&#12473; &#12512;&#12540;&#12488;&#12531;adidas&#12464;&#12524;&#12540;t&#12471;&#12515;&#12484; &#12524;&#12487;&#12451;&#12540;&#12473; &#30528;&#12371;&#12394;&#12375;adidas &#24188;&#31258;&#22290; &#12522;&#12517;&#12483;&#12463;&#12501;&#12449;&#12540;&#12473;&#12488;&#12471;&#12517;&#12540;&#12474; adidas&#12450;&#12487;&#12451;&#12480;&#12473; &#12521;&#12452;&#12531;adidas&#12398;&#22823;&#12365;&#12356;&#26178;&#35336;&#12434;&#30693;&#12387;&#12390;&#12427;&#20154;adidas &#28023;&#22806;&#12288;&#23601;&#32887;&#12468;&#12540;&#12523;&#12461;&#12540;&#12497;&#12540;&#12464;&#12525;&#12540;&#12502;&#22411;&#33853;&#12385;dance adidas &#32701;&#26681;&#12388;&#12365;&#27005;&#22825;adidas&#12458;&#12522;&#12472;&#12490;&#12523;&#12522;&#12517;&#12483;&#12463;adidas &#12495;&#12540;&#12501;&#12472;&#12483;&#12503; &#12524;&#12487;&#12451;&#12540;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473; &#12461;&#12515;&#12531;&#12497;&#12473;&#12288;&#12467;&#12531;&#12501;&#12457;&#12540;&#12488;adidas neo &#24847;&#21619;adidas &#12473;&#12491;&#12540;&#12459;&#12540; &#12473;&#12540;&#12497;&#12540;&#12473;&#12479;&#12540;<strong>adidas &#12524;&#12487;&#12451;&#12540;&#12473; &#12496;&#12483;&#12463; &#32043;,adidas &#12450;&#12487;&#12451;&#12480;&#12473; &#12501;&#12449;&#12452;&#12516;&#12540;&#12496;&#12540;&#12489;&#12472;&#12515;&#12540;&#12472;,adidas &#12473;&#12491;&#12540;&#12459;&#12540; &#24215;</strong>&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12524;&#12540;&#12473;&#12525;&#12540; &#36890;&#36009;&#12522;&#12517;&#12483;&#12463; &#38450;&#27700;  &#40658; adidas&#12450;&#12487;&#12451;&#12480;&#12473; zx&#12497;&#12540;&#12459;&#12540; &#21402;&#25163; &#12450;&#12487;&#12451;&#12480;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473;&#12522;&#12517;&#12483;&#12463;&#12500;&#12531;&#12463; &#12362;&#24215;adidas &#33109;&#26178;&#35336; &#38738; &#40644;&#33394;adidas &#12458;&#12522;&#12472;&#12490;&#12523;&#12504;&#12450;&#12496;&#12531;&#12489;&#12450;&#12487;&#12451;&#12480;&#12473; &#21050;&#32333; &#12464;&#12525;&#12540;&#12502;adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473