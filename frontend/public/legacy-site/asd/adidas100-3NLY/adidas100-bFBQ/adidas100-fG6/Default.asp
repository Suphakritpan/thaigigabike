109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12465;&#12531;&#12502;&#12522;&#12483;&#12472;[CAMBRIDGE]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#30007;&#22899;&#20860;&#29992;&#26178;&#35336;ADH2080&#65339;&#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481;&#65341;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12473; &#12469;&#12523;&#12456;&#12523;&#12497;&#12531;&#12484;&#12450;&#12487;&#12451;&#12480;&#12473; neo &#38772; &#35413;&#20385;&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12491;&#12540;&#12459;&#12540; &#31278;&#39006;&#12450;&#12487;&#12451;&#12480;&#12473; &#12488;&#12450;&#12525; &#30333;adidas &#12472;&#12515;&#12540;&#12472;&#36855;&#24425;&#12450;&#12487;&#12451;&#12480;&#12473; &#12469;&#12483;&#12459;&#12540;&#12518;&#12491;&#12507;&#12540;&#12512; &#12354;&#12356;&#12411;&#12435;&#12465;&#12540;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473;&#12521;&#12531;&#20108;&#12531;&#12464;&#12471;&#12517;&#12540;&#12474;2012&#24180;&#12514;&#12487;&#12523;adidas originals buyma&#12450;&#12487;&#12451;&#12480;&#12473; &#12496;&#12489;&#12511;&#12531;&#12488;&#12531; &#26032;&#20316;adidas &#12472;&#12515;&#12540;&#12472;&#12540; &#12475;&#12483;&#12488;&#12450;&#12483;&#12503;&#12524;&#12487;&#12451;&#12540;&#12473;adidas &#20844;&#24335;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12522;&#12517;&#12483;&#12463;&#40658;&#38738;&#12450;&#12487;&#12451;&#12480;&#12473; &#12513;&#12540;&#12523;&#20250;&#21729;</p><p>adidas &#12475;&#12524;&#12540;&#12490;&#12468;&#12513;&#12473;adidas &#12473;&#12540;&#12497;&#12540;&#12473;&#12479;&#12540;&#12288;&#12473;&#12479;&#12531;&#12473;&#12511;&#12473;adidas stan smithadidas &#12505;&#12540;&#12472;&#12517; &#12495;&#12452;&#12459;&#12483;&#12488;&#12450;&#12487;&#12451;&#12480;&#12473; &#12512;&#1