??&#12450;&#12487;&#12451;&#12480;&#12473; &#12495;&#12491;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473;&#12497;&#12540;&#12459;&#12540;&#28608;&#23433;&#36890;&#36009;adidas(&#12450;&#12487;&#12451;&#12480;&#12473;) &#12513;&#12531;&#12474; &#12454;&#12451;&#12531;&#12489;&#12502;&#12524;&#12540;&#12459;&#12540; &#12472;&#12515;&#12465;&#12483;&#12488; x49013/cu281 &#12464;&#12522;&#12540;&#12531;&#215;&#12502;&#12521;&#12483;&#12463;&#12473;&#12479;&#12531;&#12473;&#12511;&#12473; &#40658;  &#12458;&#12531;&#12521;&#12452;&#12531;&#12363;&#12418;&#12461;&#12515;&#12483;&#12503;adidas &#12502;&#12521;&#12483;&#12463;&#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12461;&#12515;&#12531;&#12487;&#12451;adidas super star 80s&#26628; &#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12473; &#12475;&#12540;&#12523;&#12450;&#12487;&#12451;&#12480;&#12473;4&#21495; &#36605;&#37327;&#12450;&#12487;&#12451;&#12480;&#12473;&#12288;&#12521;&#12452;&#12531;&#12288;&#36196;&#12288;&#31478;&#27891;&#27700;&#30528;adidas&#12496;&#12483;&#12464; &#12506;&#12483;&#12488;&#12508;&#12488;&#12523;&#12507;&#12523;&#12480;&#12540;&#12473;&#12494;&#12508; &#12497;&#12540;&#12459;&#12540; adidas&#12450;&#12487;&#12451;&#12480;&#12473; &#30333;&#12473;&#12454;&#12455;&#12483;&#12488;  &#12468;&#12540;&#12523;&#12489; &#26564;adidas world cup model &#12473;&#12491;&#12540;&#12459;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12491;&#12540;&#12459;&#12540; &#12480;&#12531;&#12473; &#12471;&#12523;&#12496;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473; &#12490;&#12452;&#12525;&#12531;&#12461;&#12515;&#12487;&#12451;&#12496;&#12483;&#12464;&#12450;&#12487;&#12451;&#12480;&#12473;&#12493;&#12458; &#12524;&#12487;&#12451;&#12540;&#12473;2014adidas adizero tempo6 wide&#12463;&#12521;&#12502;&#12450;&#12487;&#12451;&#12480;&#12473;&#12461;&#12483;&#12474;adidas &#12450;&#12487;&#12451;&#12480;&#12473; &#33109;&#26178;&#35336;&#12473;&#12