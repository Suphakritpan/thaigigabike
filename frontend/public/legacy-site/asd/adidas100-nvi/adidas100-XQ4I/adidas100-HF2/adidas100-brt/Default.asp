12473;&#12491;&#12540;&#12459;&#12540;&#12488;&#12524;&#12501;&#12457;&#12452;&#12523;&#12452;&#12516;&#12507;&#12531;&#12505;&#12483;&#12459;&#12512; &#12450;&#12487;&#12451;&#12480;&#12473;&#12461;&#12515;&#12531;&#12496;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473;&#12479;&#12463;&#12486;&#12451;&#12459;&#12523;adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals&#26178;&#35336; adidas originals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12491;&#12517;&#12540;&#12520;&#12540;&#12463;&#12471;&#12486;&#12451;[NYC]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#30007;&#22899;&#20860;&#29992;&#26178;&#35336;ADH6104&#65339;&#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481;&#65341;&#12450;&#12487;&#12451;&#12480;&#12473;&#12288;&#12473;&#12479;&#12531; &#12501;&#12457;&#12540;&#12510;&#12523;&#12450;&#12487;&#12451;&#12480;&#12473; &#12362;&#20154;&#24418;&#12473;&#12491;&#12540;&#12459;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473;&#12468;&#12523;&#12501;&#12474;&#12508;&#12531;&#30333;abc&#12510;&#12540;&#12488;&#12467;&#12521;&#12508; &#12450;&#12487;&#12451;&#12480;&#12473; &#26381;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#12471;&#12519;&#12483;&#12503; iphone&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12491;&#12540;&#12459;&#12540;  &#12524;&#12487;&#12451;&#12540;&#12473;&#12288;&#12464;&#12524;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; 2009 &#12464;&#12522;&#12540;&#12531;adidas&#20108;&#12388;&#25240;&#12426;iphone5&#12459;&#12496;&#12540;</p><p>&#12450;&#12487;&#12451;&#12480;&#12473; tiro13 &#12495;&#12540;&#12501;&#12497;&#12531;&#12484;&#12458;&#12471;&#12515;&#12524;&#12524;&#12487;&#12451;&#12540;&#12473;&#12450;&#12487;&#12451;&#1248