&#12487;&#12451;&#12480;&#12473; &#30707;&#27941;&#24535;&#31298;&#12472;&#12517;&#12491;&#12450;&#12472;&#12515;&#12540;&#12472;&#12450;&#12487;&#12451;&#12480;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12288;&#12461;&#12523;&#12488; &#12473;&#12491;&#12540;&#12459;&#12540;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; adidas&#26178;&#35336; adidas &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12497;&#12501;&#12457;&#12540;&#12510;&#12531;&#12473; &#12450;&#12487;&#12451;&#12476;&#12525; PERFORMANCE ADIZERO &#12518;&#12491;&#12475;&#12483;&#12463;&#12473;/&#30007;&#22899;&#20860;&#29992;/&#28082;&#26230; ADP3512[&#36865;&#26009;&#28961;&#26009;][&#12461;&#12483;&#12474; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#26178;&#35336; &#12473;&#12509;&#12540;&#12484; &#12469;&#12483;&#12459;&#12540;]&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12517;&#12483;&#12463; &#36890;&#36009;adidas &#12458;&#12522;&#12472;&#12490;&#12523;&#12473; &#30333;&#37329;adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12454;&#12540;&#12473;&#12479;&#12540;&#12467;&#12524;&#12463;&#12471;&#12519;&#12531;[WOOSTER COLLECTION]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#30007;&#22899;&#20860;&#29992;&#26178;&#35336;ADH6036[&#12521;&#12531;&#12491;&#12531;&#12464;&#12454;&#12457;&#12483;&#12481; &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; &#12473;&#12509;&#12540;&#12484;&#26178;&#35336;]adidas &#12524;&#12487;&#12451;&#12540;&#12473; &#12471;&#12523;&#12496;&#12540;&#12495;&#12452;&#12459;&#12483;&#12488;adidas &#12456;&#12540;&#12473; &#12522;&#12517;&#12483;&#12463;adidas &#12471;&#12517;&#12540;&#12474; &#12488;&#12524;&#12452;&#12523;&#12450;&#12487;&#12451;&#12480;&#12473; team base</p><p>&#12450;&#12487;&#12451;&#12480;&#12473; &#12488;&#12540;&#12488;&#12496;&#12483;&#12464;adidasoriginals t&#12471;&#12515;&#12484;adidast&#12471;&#12515;&#12484;&#12467;&#12531;&#12450;&#12487;&#12451;&#12480;&#12473; &#12461;&#12483;&#12474; &#12501;&#12449;&#12483;&#12471;&#12519;&#12531;&#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;   &#33457;&#26564; &#36890;&#36009;adidas &#12471;&#12519;&#12540;&#12488;&#12497;&#12531;&#12484; &#12524;&#12487;&#12451;&#12540;&#12473;adidas originals &#12499;&#12540;&#12469;&#12531; &#36009;&#22770;&#24215;&#12450;&#12487;&#12451;&#12480;&#12473;&#12288;&#12473;&#12491;&#12540;&#12459;&#12540;&#12288;&#12452;&#12531;&#12524;&#12483;&#12489;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12461;&#12515;&#12531;&#12487;&#12451;&#12471;&#12522;&#12540;&#12474;&#12467;&#12524;&#12463;&#12471;&#12519;&#12531; &#12513;&#12479;&#12523;[CANDY COLLECTION]&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473; ADH6004[&#36865;&#26009;&#28961;&#26009;][&#12461;&#12483;&#12474; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#26178;&#35336; &#12473;&#12509;&#12540;&#12484; &#12469;&#12483;&#12459;&#12540;]&#12450;&#12487;&#12451;&#12480;&#12473; &#12499;&#12483;&#12464;t&#12471;&#12515;&#12484; &#12524;&#12487;&#12451;&#12540;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473; &#12488;&#12540;&#12488;&#12496;&#12483;&#12464;adidasoriginals t&#12471;&#12515;&#12484;adidast&#12471;&#12515;&#12484;&#12467;&#12531;&#12450;&#12487;&#12451;&#12480;&#12473; &#12461;&#12483;&#12474; &#12501;&#12449;&#12483;&#12471;&#12519;&#12531;&#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;   &#33457;&#26564; &#36890;&#36009;adidas &#12471;&#12519;&#12540;&#12488;&#12497;&#12531;&#12484; &#12524;&#12487;&#12451;&#12540;&#12473;adidas originals &#12499;&#12540;&#12469;&#12531; &#36009;&#22770;&#24215;&#12450;&#12487;&#12451;&#12480;&#12473;&#12288;&#12473;&#12491;&#12540;&#12459;&#12540;&#12288;&#12452;&#12531;&#12524;&#12483;&#12489;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12461;&#12515;&#12531;&#12487;&#12451;&#12471;&#12522;&#12540;&#12474;&#12467;&#12524;&#12463;&#12471;&#12519;&#12531; &#12513;&#12479;&#12523;[CANDY COLLECTION]&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473; ADH6004[&#36865;&#26009;&#28961;&#26009;][&#12461;&#12483;&#12474; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#26178;&#35336; &#12473;&#12509;&#12540;&#12484; &#12469;&#12483;&#12459;&#12540;]&#12450;&#12487;&#12451;&#12480;&#12473; &#12499;&#12483;&#12464;t&#12471;&#12515;&#12484; &#12524;&#12487;&#12451;&#12540;&#12473;adidas &#12454;&#12451;&#12531;&#12489;&#12502;&#12524;&#12540;&#12459;&#12540; &#20001;&#33109;&#12481;&#12515;&#12483;&#12463;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12473; &#12522;&#12517;&#12483;&#12463; &#36196;&#12450;&#12487;&#12451;&#12480;&#12473;&#26087;&#12525;&#12468;t&#12471;&#12515;&#12484;&#12450;&#12487;&#12451;&#12480;&#12473; &#12469;&#12483;&#12459;&#12540;&#12508;&#12540;&#12523; &#12471;&#12519;&#12523;&#12