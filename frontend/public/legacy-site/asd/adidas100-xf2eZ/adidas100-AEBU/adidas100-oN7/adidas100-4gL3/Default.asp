	<p>adidas &#12461;&#12515;&#12483;&#12503; &#12521;&#12531;&#12491;&#12531;&#12464; &#12524;&#12487;&#12451;&#12540;&#12473;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals adidas originals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12473;&#12500;&#12531;[SPIN]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#12461;&#12483;&#12474;&#26178;&#35336;/ADM2042 [ &#12461;&#12483;&#12474;&#29992; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#33109;&#26178;&#35336;&#65341;[&#36865;&#26009;&#28961;&#26009;]adidas &#33109;&#26178;&#35336; &#38738; &#40644;&#33394;&#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#12288;&#31179;&#20908;&#12472;&#12515;&#12540;&#12472;adidas(&#12450;&#12487;&#12451;&#12480;&#12473;) &#12486;&#12491;&#12473;&#12471;&#12517;&#12540;&#12474; &#12513;&#12531;&#12474; g51946adidas &#12388;&#12367;&#12400;adidas &#12502;&#12524;&#12452;&#12502;dance adidas &#32701;&#26681;&#12388;&#12365;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals&#26178;&#35336;]( adidas originals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#26178;&#35336; )&#12477;&#12454;&#12523;[Seoul]&#12507;&#12527;&#12452;&#12488;/ADH2108[&#36865;&#26009;&#28961;&#26009;][&#12461;&#12483;&#12474; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#26178;&#35336; &#12473;&#12509;&#12540;&#12484; &#12469;&#12483;&#12459;&#12540;]adidas &#26178;&#35336; &#21644;&#27468;&#23665;&#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12510;&#12452;&#12467;&#12540;&#12481;&#12288;2014adidas&#40644;&#33394;&#12472;&#12515;&#12540;&#12472;&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12524;&#12540;&#12473;&#12525;&#12540; martadidas &#12497;&#12486;&#12451;&#12540;&#12463; &#37329;&#33394;&#12495;&#12540;&#12501;&#12497;&#12531;&#12484; &#38738; &#12467;&#12540;&#12487; &#12513;&#12531;&#12474;adidas &#12522;&#12517;&#12483;&#12463; &#12452;&#12456;&#12525;&#12540; &#12502;&#12523;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473; &#12481;&#12455;&#12483;&#12463; &#12497;&#12540;&#12459;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473;  &#12472;&#12540;&#12531;&#12474;&#29983;&#22320;&#26381;&#12472;&#12515;&#12540;&#12472; &#37329; &#38738;&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12491;&#12540;&#12459;&#12540;&#12525;&#12483;&#12489;&#12524;&#12452;&#12496;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523; &#12524;&#12522;&#12540;&#12473;&#12525;&#12540;adidas &#12521;&#12531;&#12491;&#12531;&#12464;&#12471;&#12517;&#12540;&#12474; &#12459;&#12473;&#12479;&#12512;&#12450;&#12487;&#12451;&#12480;&#12473; &#22799;&#26381; &#12506;&#12450;&#12450;&#12487;&#12451;&#12480;&#12473; original t&#12471;&#12515;&#12484;&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12479;&#12531;&#12473;&#12511;&#12473; &#12524;&#12487;&#12451;&#12540;&#12473; &#12498;&#12540;&#12523; &#12524;&#12483;&#12489;<strong>&#12450;&#12487;&#12451;&#12480;&#12473; &#12469;&#12531;&#12496; &#12471;&#12519;&#12540;&#12488;&#12497;&#12531;&#12484;,[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals adidas originals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12473;&#12500;&#12531;[SPIN]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#12461;&#12483;&#12474;&#26178;&#35336;/ADM2042 [ &#12461;&#12483;&#12474;&#29992; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#33109;&#26178;&#35336;&#65341;[&#36865;&#26009;&#28961;&#26009;],&#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#12288;&#31179;&#20908;&#12472;&#12515;&#12540;&#12472;</strong>&#12450;&#12487;&#12451;&#12480;&#12473;&#12495;&#12527;&#12452;&#12450;&#12531;&#12497;&#12540;&#12459;&#12540;adidas &#12463;&#12521;&#12452;&#12510;&#12463;&#12540;&#12523; &#12471;&#12517;&#12540;&#12474;adidas f50 &#24847;&#21619;&#12450;&#12487;&#12451;&#12480;&#12473; &#12450;&#12487;&#12451;&#12450;&#12531;&#12484;&#12457;&#12461;&#12515;&#12503;&#12486;&#12531;&#32764; adidas &#12467;&#12521;&#12508;&#12450;&#12487;&#12451;&#12480;&#12473;&#12288;&#12450;&#12487;&#12451;&#12480;&#12473;&#12501;&#12451;&#12483;&#12488;&#12288;&#28608;&#23433;exile &#12473;&#12479;&#12540;&#12497;&#12540;&#12459;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473;&#12458;&#12522;&#12472;&#12490;&#12523; &#30007;&#23376;adidas &#38738;&#12472;&#12515;&#12540;&#12472; &#21322;&#12497;&#12531;adidas &#12471;&#12517;&#12540;&#12474; &#12488;&#12524;&#12452;&#12523;[ &#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481; ] adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12473;&#12488;&#12522;&#12540;&#12488;&#12488;&#12524;&#12540;&#12469;&#12540;[streettracer]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#12461;&#12483;&#12474;&#26178;&#35336;/ADM2025 [ &#12461;&#12