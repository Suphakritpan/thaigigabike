	<p>&#12450;&#12487;&#12451;&#12480;&#12473; original t&#12471;&#12515;&#12484;adidas &#38450;&#27700; &#12497;&#12540;&#12459;&#12540;adidas &#12473;&#12491;&#12540;&#12459;&#12540; &#12473;&#12540;&#12503;&#25522;&#36617;&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12491;&#12540;&#12459;&#12540; &#12522;&#12524;&#12540;&#12473;&#12525;&#12540; &#12521;&#12531;&#12461;&#12531;&#12464;&#12450;&#12487;&#12451;&#12480;&#12473; &#12510;&#12522;&#12531;&#12471;&#12517;&#12540;&#12474;&#21322;&#34966;&#12497;&#12540;&#12459;&#12540;&#12450;&#12487;&#12451;&#12480;&#12473;adidas &#12471;&#12517;&#12540;&#12474; &#12467;&#12540;&#12487;adizero [&#12450;&#12487;&#12451;&#12476;&#12525;] takumi sen adizero takumi-sen &#12498;&#12519;&#12454;&#26564;&#12477;&#12483;&#12463;&#12473; &#30333; adidas&#12450;&#12487;&#12451;&#12480;&#12473; &#12487;&#12491;&#12512;&#32032;&#26448;&#12522;&#12517;&#12483;&#12463;&#12450;&#12487;&#12451;&#12480;&#12473; &#12486;&#12491;&#12473; &#12477;&#12483;&#12463;&#12473;2013 adidas &#12459;&#12521;&#12501;&#12523;&#12496;&#12483;&#12463;&#12497;&#12483;&#12463; aczozotown adidas originals&#12473;&#12491;&#12540;&#12459;&#12540;&#12510;&#12491;&#12450;adidas&#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;adidas &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523;&#12473;&#33109;&#26178;&#35336;[adidasoriginals&#26178;&#35336; adidas originals &#33109;&#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12450;&#12487;&#12451;&#12480;&#12473;&#33109;&#26178;&#35336; ]&#12477;&#12454;&#12523;[SEOUL]/&#12513;&#12531;&#12474;/&#12524;&#12487;&#12451;&#12540;&#12473;/&#30007;&#22899;&#20860;&#29992;&#26178;&#35336;ADH2044&#65339;&#12473;&#12509;&#12540;&#12484;&#12454;&#12457;&#12483;&#12481;&#65341;&#12450;&#12487;&#12451;&#12480;&#12473;&#12497;&#12540;&#12459;&#12540;&#12498;&#12519;&#12454;&#26564;&#12365;&#12419;&#12426;&#12540;&#12401;&#12415;&#