&#12487;&#12451;&#12480;&#12473; &#26178;&#35336; &#12465;&#12531;&#12502;&#12522;&#12483;&#12472; CAMBRIDGE &#12513;&#12531;&#12474; &#12524;&#12487;&#12451;&#12540;&#12473; &#12518;&#12491;&#12475;&#12483;&#12463;&#12473;/&#30007;&#22899;&#20860;&#29992;/&#12502;&#12523;&#12540; ADH2099 [&#36870;&#36664;&#20837; &#28023;&#22806;&#12514;&#12487;&#12523; &#26032;&#21697;][&#12461;&#12483;&#12474; &#23376;&#20379;&#29992; &#12461;&#12483;&#12474;&#26178;&#35336; &#12473;&#12509;&#12540;&#12484; &#12469;&#12483;&#12459;&#12540;]adidas &#12472;&#12515;&#12540;&#12472; &#12461;&#12483;&#12474;&#26032;&#23487; &#12500;&#12450;&#12473; &#23433;&#12356;&#21830;&#21697;&#12450;&#12487;&#12451;&#12480;&#12473;&#12488;&#12524;&#12452;&#12523;&#12471;&#12517;&#12540;&#12474; &#12524;&#12487;&#12451;&#12540;&#12473;&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12508;&#12531;&#12473;&#12491;&#12540;&#12459;&#12540;adizero&#12450;&#12487;&#12451;&#12476;&#12525;takumi ren&#12524;&#12487;&#12451;&#12540;&#12473;&#37340;&#23665; &#12450;&#12487;&#12451;&#12480;&#12473;&#26178;&#35336;adidas takumi ren2adidas&#12525;&#12487;&#12458;adidas neo &#24847;&#21619;&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12517;&#12483;&#12463;&#19977;&#12388;&#33865;&#12288;2014&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12524;&#12540;&#12473;&#12525;&#12540;&#12288;&#20154;&#27671;&#12450;&#12487;&#12451;&#12480;&#12473; &#12501;&#12483;&#12488;&#12469;&#12523;&#12471;&#12517;&#12540;&#12474; &#12507;&#12527;&#12452;&#12488;&#12450;&#12487;&#12451;&#12480;&#12473;&#12472;&#12455;&#12524;&#12511;&#12540;&#12473;&#12467;&#12483;&#12488;&#21462;&#25201;&#24215;<strong>adidas &#12522;&#12517;&#12483;&#12463; &#12469;&#12452;&#12474;,adidas &#12499;&#12483;&#12464;&#12525;&#12468;,adizero mana &#27508;&#21490;</strong>&#12459;&#12483;&#12503;&#12523; &#12506;&#12450;&#12523;&#12483;&#12463; t&#12471;&#12515;&#12484; &#12450;&#12487;&#12451;&#12480;&#12473;[ &#12473;&#12509;&#12540;&#1248