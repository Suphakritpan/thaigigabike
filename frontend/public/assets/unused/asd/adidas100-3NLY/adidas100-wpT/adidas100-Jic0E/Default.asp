&#12464;<strong>&#12450;&#12487;&#12451;&#12480;&#12473; &#12472;&#12515;&#12540;&#12472; &#12522;&#12496;&#12503;&#12540;&#12523;,&#12450;&#12487;&#12451;&#12480;&#12473;  &#12450;&#12531;&#12486;&#12451;&#12540;&#12463;&#12495;&#12452;&#12459;&#12483;&#12488;&#12471;&#12517;&#12540;&#12474;,&#12450;&#12487;&#12451;&#12480;&#12473; &#12522;&#12524;&#12540;&#12473;&#12525;&#12540; &#36196;&#32016;</strong>&#12450;&#12513;&#26449;&#12395;&#22770;&#12387;&#12390;&#12427;&#12450;&#12487;&#12451;&#12480;&#12473;&#12522;&#12517;&#12483;&#12463;&#12398;&#20516;&#27573;&#12450;&#12487;&#12451;&#12480;&#12473; &#12473;&#12491;&#12540;&#12459;&#12540; 2014  &#12500;&#12531;&#12463;&#12508;&#12487;&#12451;&#12496;&#12483;&#12464; &#12524;&#12487;&#12451;&#12540;&#12473; &#12467;&#12540;&#12487;&#12451;&#12493;&#12540;&#12488;    &#12467;&#12540;&#12487;&#12451;&#12493;&#12540;&#12488;&#12450;&#12487;&#12451;&#12480;&#12473; &#12458;&#12522;&#12472;&#12490;&#12523; &#12487;&#12470;&#12540;&#12488; &#12495;&#12491;&#12540;adidas &#12461;&#12483;&#12474; &#12454;&#12451;&#12531;&#12489;&#12502;&#12524;&#12540;&#12459;&#12540;&#12365;&#12419;&#12426;&#12540; &#12450;&#12487;&#12451;&#12480;&#12473; &#26178;&#35336;ac &#12511;&#12521;&#12531; &#12472;&#12517;&#12491;&#12450; &#12450;&#12487;&#12451;&#12480;&#12473; &#12518;&#12491;&#12501;&#12457;&#12540;&#12512;&#12450;&#12487;&#12451;&#12480;&#12473;&#12288;&#23665;&#26412;&#24425;&#12450;&#12487;&#12451;&#12480;&#12473; &#12499;&#12461;&#12491;adidas &#12450;&#12452;&#12501;&#12457;&#12531;5s&#12465;&#12540;&#12473; &#21644;&#12450;&#12487;&#12451;&#12480;&#12473; &#12496;&#12489;&#12511;&#12531;&#12488;&#12531;&#12471;&#12517;&#12540;&#12474; &#24863;&#24819;&#12450;&#12487;&#12451;&#12480;&#12473; &#12524;&#12487;&#12451;&#12540;&#12473; &#12501;&#12521;&#12527;&#12540;&#12503;&#12522;&#12531;&#12488; &#12522;&#12524;&#12540;&#12473;&#12525;&#12540;&#12452;&#12531;&#12479;&#12540;&#12493;&#12483;&#12488;&#12391;&#22770;&#1238